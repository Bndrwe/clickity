{
  "name": "clickity",
  "productName": "Clickity",
  "version": "0.1.0",
  "description": "Clicky, but free & open source: an AI companion that lives next to your cursor. Hold a key, talk, and it looks at your screen and points the way. Bring your own Claude, ChatGPT, Gemini, OpenRouter or local model.",
  "main": "dist/main/index.js",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:fnwatch": "sh scripts/build-fnwatch.sh",
    "dev": "node scripts/build.mjs && electron .",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "node scripts/build.mjs && electron-builder --publish never",
    "dist:mac": "node scripts/build.mjs && electron-builder --mac --publish never",
    "dist:win": "node scripts/build.mjs && electron-builder --win --publish never",
    "dist:linux": "node scripts/build.mjs && electron-builder --linux --publish never"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@types/node": "^22.10.0",
    "animejs": "^4.5.0",
    "electron": "^45.2.2",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  },
  "author": {
    "name": "clickity contributors"
  },
  "homepage": "https://github.com/Bndrwe/clickity",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bndrwe/clickity.git"
  }
}
